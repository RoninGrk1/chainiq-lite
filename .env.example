# Cloudflare Workers AI (server-side only)
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_AI_MODEL=@cf/meta/llama-3.1-8b-instruct

# Supabase (public anon for browser; service role server-only)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# CoinGecko Demo API (optional — public demo works with lower rate limits)
COINGECKO_API_KEY=

# Etherscan (free API key recommended)
ETHERSCAN_API_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
